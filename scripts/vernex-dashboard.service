[Unit]
Description=Vernex Protocol Dashboard
After=network.target vernex-daemon.service
Wants=vernex-daemon.service

[Service]
Type=simple
User=ericgeer
WorkingDirectory=/home/ericgeer/vernex/dashboard
ExecStart=/bin/bash -c 'source /home/ericgeer/vernex/dashboard/venv/bin/activate && python3 /home/ericgeer/vernex/dashboard/app.py'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
